#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build/tests"
cd "$ROOT/build/tests"

qmake6 "$ROOT/tests/anvil_tests.pro"
make -j"${ANVIL_BUILD_JOBS:-4}"
QT_QPA_PLATFORMTHEME=generic QT_FORCE_STDERR_LOGGING=1 QT_QUICK_BACKEND=software QT_QPA_PLATFORM=offscreen ./anvil_tests
